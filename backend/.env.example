SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
# Required only for the first admin in an empty user database; supply privately.
ADMIN_INITIAL_PASSWORD=
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
FLASK_ENV=production
CORS_ORIGINS=https://cinderellacakesug.com,https://www.cinderellacakesug.com
SERVER_BASE_URL=https://cinderella-cakes-api.onrender.com

# Ship all 120 catalog originals with the deployment, or set an absolute server directory.
# Relative source paths resolve from backend; --source-dir overrides this value.
GALLERY_SOURCE_DIR=../frontend/src/assets/gallery
# Existing customer-inspiration root; blank keeps app/static/uploads/inspiration.
# In production set this to persistent storage and retain all existing media there.
# Newly stored gallery media uses its gallery/ subdirectory; old files are not moved.
UPLOAD_FOLDER=

# After backups, connection review, and source preparation, from backend on Windows:
# .\venv\Scripts\python.exe -m flask --app run:app db upgrade
# .\venv\Scripts\python.exe seed.py --gallery-only
# For initial site/account bootstrap instead: .\venv\Scripts\python.exe seed.py
# Gallery-only import never needs or changes the administrator password.
# On Linux use the virtual environment's python in place of .\venv\Scripts\python.exe.
# Separately, in frontend/.env or the frontend build environment (not this backend file):
# VITE_API_URL=https://cinderella-cakes-api.onrender.com
# Use the backend origin only, without /api; allow the frontend origin in CORS_ORIGINS.
